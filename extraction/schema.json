     ]
    },
    "input_dimensionality": {
     "enum": [
      "2D_single_frame",
      "2D_multi_frame",
      "2D_plus_time_video",
      "multi_view",
      "3D_volume",
      "mixed",
      "not_reported"
     ]
    },
    "supervision": {
     "enum": [
      "fully_supervised",
      "semi_supervised",
      "self_supervised",
      "weakly_supervised",
      "unsupervised",
      "mixed",
      "not_applicable"
     ]
    },
