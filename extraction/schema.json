      "string",
      "null"
     ]
    },
    "uncertainty_quantification": {
     "type": "boolean"
    },
    "explainability_method": {
     "type": [
      "string",
      "null"
     ]
    },
    "federated_or_privacy_preserving": {
     "type": "boolean"
    },
    "uses_llm_or_vlm": {
     "type": "boolean"
    },
    "real_time_or_inference_time_reported": {
     "type": "boolean"
    }
