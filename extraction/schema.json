   "type": "object",
   "additionalProperties": false,
   "properties": {
    "architecture_names": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "architecture_family": {
     "enum": [
      "unet_encoder_decoder",
      "cnn_classifier",
      "detector",
      "transformer",
      "hybrid_cnn_transformer",
      "recurrent",
      "generative_gan_diffusion",
      "foundation_or_vlm",
      "classical_ml",
      "non_learning",
      "other"
     ]
    },
    "temporal_category": {
     "enum": [
      "none",
      "frame_aggregation",
      "optical_flow_registration",
      "recurrent",
      "cnn3d_video",
      "transformer_ssm",
      "hemodynamic_physics",
      "not_determinable"
     ]
    },
    "temporal_evidence": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "quote": {
         "type": "string",
         "minLength": 3
        },
        "section": {
         "enum": [
          "abstract",
          "introduction",
          "methods",
          "results",
          "discussion",
          "conclusion",
          "other"
         ]
        }
       },
       "required": [
        "quote",
        "section"
       ]
      },
      {
       "type": "null"
