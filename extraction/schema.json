{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "AngioVision SLR stage-2 extraction v2",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "record_id": {
   "type": "string",
   "pattern": "^R[0-9]{4}$"
  },
  "schema_version": {
   "const": "2.0"
  },
  "study": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "title": {
     "type": "string"
    },
    "year": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "venue": {
     "type": [
      "string",
      "null"
     ]
    },
    "publication_type": {
     "enum": [
      "journal",
      "conference_full_paper",
      "conference_abstract",
      "preprint",
      "book_chapter",
      "other"
     ]
    },
    "text_is_full_paper": {
     "type": "boolean"
    },
    "country_of_data": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "title",
    "year",
    "venue",
    "publication_type",
    "text_is_full_paper",
    "country_of_data"
   ]
  },
  "imaging": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "modality": {
     "enum": [
      "DSA",
      "xray_fluoroscopy",
      "DSA_and_fluoroscopy",
      "other"
     ]
    },
    "modality_detail": {
     "type": [
      "string",
      "null"
     ]
    },
    "territory": {
     "enum": [
      "neurologic",
      "cardiac",
      "aortic_thoracic",
      "abdominopelvic",
      "peripheral",
      "multi",
      "other",
      "not_reported"
     ]
    },
    "territory_detail": {
     "type": [
      "string",
      "null"
     ]
    },
    "acquisition_geometry": {
     "enum": [
      "monoplane",
      "biplane",
      "rotational_3D",
      "mixed",
      "not_reported"
     ]
    },
    "frame_rate_fps": {
     "type": [
      "number",
      "null"
     ]
    },
    "frames_per_sequence": {
     "type": [
      "string",
      "null"
     ]
    },
    "vendors": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "modality",
    "modality_detail",
    "territory",
    "territory_detail",
    "acquisition_geometry",
    "frame_rate_fps",
    "frames_per_sequence",
    "vendors"
