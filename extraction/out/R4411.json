  "gaps": {
    "G1": {"status": "none", "quote": null, "section": null},
    "G2": {"status": "documents", "quote": "As the data used in this study was acquired from one hospital using a machine from a single vendor, it would be interesting to evaluate the proposed approach on multi-center data acquired with machines from different vendors.", "section": "discussion"},
    "G3": {"status": "both", "quote": "our approach takes into account of the information between frames; the Bayesian filtering framework allows interaction between temporal information and the detection of a convolutional neural network, making the tracking more robust.", "section": "discussion"},
    "G4": {"status": "documents", "quote": "the whole DCR approach works only when the offline and online phase have the same view angle, i.e. it is a 2D roadmapping system.", "section": "discussion"},
    "G5": {"status": "both", "quote": "As the segmentation labels are often more expensive to acquire than the detection label in practice, we also investigated the performance of catheter tip detection, tracking and dynamic coronary roadmapping without segmenting the catheter.", "section": "other"},
    "G6": {"status": "documents", "quote": "it would be also interesting to validate our approach during PCI procedures in an environment simulating the real clinical settings.", "section": "discussion"},
